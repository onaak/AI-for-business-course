# Copy this file to .env and fill it in. Never commit .env.
#
# GATEWAY_MODE
#   replay  (default) returns stored responses from data/fixtures/llm. No key needed.
#           Replay results are never test evidence.
#   live    calls the model. Needs LLM_PROVIDER, LLM_API_KEY and model names.
#   record  as live, and stores every response as a replay fixture. Use this one:
#           the real answers can then be shown later in replay mode, with no model.
GATEWAY_MODE=replay

# APP_MODE
#   lab    (default) the eye switch in the header chooses Full or Clean view on each device.
#   field  the clean view, fixed, with no switch: make an SJA, the worker check, the record
#          and the rules library, in NO or EN. Test pages cannot be opened by URL.
#          Use it when you share the prototype (npm run share does this for you).
APP_MODE=lab

# PACK_READONLY=1 refuses every change to the data pack (keys, corrections, reset).
#   npm run share sets it, so nobody with the tunnel address can overwrite the reviewers' work.
PACK_READONLY=

# LLM_PROVIDER: anthropic | openai-compatible
LLM_PROVIDER=anthropic
LLM_API_KEY=

# Only for openai-compatible endpoints (OpenAI, Gemini, Ollama, Mistral ...)
LLM_BASE_URL=https://api.openai.com/v1

# Model names are configuration. Check your provider's current model list;
# the names below are examples only.
MODEL_DEFAULT=claude-sonnet-4-5
# Back-translation (P5) should use a different model if you have one (specification, section 13).
# Leave empty to use MODEL_DEFAULT in an isolated call; that limitation is then written into the evidence.
MODEL_BACKTRANSLATE=
# Optional per-task overrides: MODEL_P1 ... MODEL_P7

# Lowest randomness the model offers. Leave empty for models that reject the parameter.
LLM_TEMPERATURE=0

# Pacing for free tiers, which limit requests per minute.
#   LLM_MAX_PARALLEL      at most this many calls at once (default 3)
#   LLM_MIN_INTERVAL_MS   at least this long between two calls (default 0). For a limit of
#                         10 requests per minute, use 6000.
#   LLM_RATE_LIMIT_WAITS  after "too many requests" (HTTP 429), wait and try again up to
#                         this many times (default 5). These waits are not the one retry.
LLM_MAX_PARALLEL=3
LLM_MIN_INTERVAL_MS=0
LLM_RATE_LIMIT_WAITS=5

PORT=5173

# ---------------------------------------------------------------------------
# Free options (no paid key). Copy one block over the settings above.
#
# A) Gemini free tier (Google AI Studio, no billing enabled).
#    On the free tier Google may use what you send to improve its products. That is
#    acceptable only because every input in this prototype is synthetic (CR-17).
#    Say so in Appendix B. Check the current free model names in AI Studio.
# GATEWAY_MODE=record
# LLM_PROVIDER=openai-compatible
# LLM_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai/
# LLM_API_KEY=<your AI Studio key>
# MODEL_DEFAULT=<a Flash model from the free list>
# LLM_MAX_PARALLEL=2
# LLM_MIN_INTERVAL_MS=6000
#
# B) Ollama on your own computer (no account, nothing leaves the laptop).
#    Install Ollama, run "ollama pull <model>", keep Ollama running.
#    Small local models translate Lithuanian, Polish and Russian noticeably worse.
# GATEWAY_MODE=record
# LLM_PROVIDER=openai-compatible
# LLM_BASE_URL=http://localhost:11434/v1
# LLM_API_KEY=ollama
# MODEL_DEFAULT=<the model you pulled>
# LLM_MAX_PARALLEL=1
#
# C) Both: Gemini for everything, Ollama for back-translation only (recommended).
#    This gives the independent second model for P5 that the specification asks
#    for (section 13), at no cost. Use block A, then add:
# BACKTRANSLATE_BASE_URL=http://localhost:11434/v1
# BACKTRANSLATE_API_KEY=ollama
# MODEL_BACKTRANSLATE=<the model you pulled in Ollama>
